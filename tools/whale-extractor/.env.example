# ── wex v2 scan (Phase 0+1+2) — set at least one ───────────────────────────
MORALIS_KEY=your_moralis_api_key_here        # EVM net-worth (primary)
MORALIS_KEYS=                                # optional comma-separated rotation
ANKR_KEY=your_ankr_api_key_here              # multi-chain portfolio + extras
ANKR_KEYS=                                   # optional comma-separated rotation

# ── Legacy discovery (whale_extractor.py / mega_scan) ─────────────────────
ETHERSCAN_KEY=your_etherscan_api_key_here
HELIUS_KEY=your_helius_api_key_here          # Solana optional
TRON_KEY=                                    # TronGrid optional
SUBSCAN_KEY=                                 # Polkadot optional
BLOCKFROST_KEY=                              # Cardano optional

# ── Optional — Free APIs ───────────────────────────────────────────────────
CHAINBASE_KEY=your_chainbase_api_key_here
ALCHEMY_KEY=your_alchemy_api_key_here        # free: 300M CU/month (NFT + PnL)
ALCHEMY_KEYS=                                # comma-separated rotation
# ── Legion bridge (Phase 4 — export only) ───────────────────────────────────
LEGION_CLIENT_CONFIG_URL=https://sadrailala-production.up.railway.app/api/v1/client-config


# ── AI Judge Panel — add ALL keys you have ────────────────────────────────
# Script auto-detects which keys are set and runs panel mode when 2+ are found
# All providers compete → judge picks the best summary → winner logged

# Groq (FREE — 14400 req/day) → console.groq.com
GROQ_KEY=your_groq_api_key_here

# Gemini (FREE — 1500 req/day) → aistudio.google.com
GEMINI_KEY=your_gemini_api_key_here

# Claude Haiku (~$0.25/1000 whales) → console.anthropic.com
ANTHROPIC_KEY=your_anthropic_api_key_here

# OpenAI GPT-4o-mini (~$10/1000 whales) → platform.openai.com
OPENAI_KEY=your_openai_api_key_here

# Ollama (FREE, local) → ollama.com then: ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Judge Config ──────────────────────────────────────────────────────────
# JUDGE_PROVIDER: which AI evaluates all summaries and picks the best
# Leave blank → auto-selects best available free provider (groq > gemini > claude > openai)
JUDGE_PROVIDER=

# AI_PROVIDER: only used when just 1 key is set (single mode, no panel)
AI_PROVIDER=none

# ── Outreach / Messaging Config ───────────────────────────────────────────
# These are used to generate personalized messages for each whale

PROJECT_NAME=Your Project Name
PROJECT_DESC=a next-gen DeFi protocol for serious investors
PROJECT_TWITTER=@yourproject
PROJECT_URL=https://yourproject.xyz

# OUTREACH_TONE: professional | casual | crypto_native
OUTREACH_TONE=crypto_native

# OUTREACH_GOAL: partnership | investment | community | airdrop | custom
OUTREACH_GOAL=community

# Custom pitch (optional — if OUTREACH_GOAL=custom, use this as the core offer)
OUTREACH_PITCH=

# ── Other Optional ────────────────────────────────────────────────────────
OSINT_KEY=your_onchainindustries_key_here
